{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daojinfan/large-project-governance-framework/schemas/work-package-context.schema.json",
  "title": "工作包上下文路由",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "work_package", "baseline", "scope", "required_documents", "decisions", "validation"],
  "properties": {
    "$schema": { "const": "schemas/work-package-context.schema.json" },
    "schema_version": { "const": 1 },
    "work_package": { "type": "string", "pattern": "^WP-[0-9]{3,}$" },
    "baseline": { "type": "string", "pattern": "^BL-[0-9]{3,}$" },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["doc_id", "mode"],
        "properties": {
          "doc_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
          "mode": { "enum": ["full", "summary"] }
        }
      }
    },
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^DEC-[0-9]{3,}$" }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
