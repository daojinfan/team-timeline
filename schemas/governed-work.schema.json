{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daojinfan/large-project-governance-framework/schemas/governed-work.schema.json",
  "title": "AI 治理执行任务契约",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "task_id", "work_package", "title", "goal", "baseline", "profile", "allowed_paths", "out_of_scope", "authoritative_documents", "dependencies", "acceptance_criteria", "validations", "risk_flags", "created_at"],
  "properties": {
    "$schema": { "const": "schemas/governed-work.schema.json" },
    "schema_version": { "enum": [1, 2] },
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
    "work_package": { "type": "string", "pattern": "^WP-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "baseline": { "type": "string", "pattern": "^BL-[0-9]{3,}$" },
    "profile": { "enum": ["Lite", "Standard", "Release"] },
    "allowed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/projectPath" } },
    "out_of_scope": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "authoritative_documents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" } },
    "repair_of": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" } },
    "acceptance_criteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "validations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "args"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,63}$" },
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "release_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_environment", "execution_window", "rollback_plan", "observation_metrics", "stop_conditions", "post_release_owner"],
      "properties": {
        "target_environment": { "type": "string", "minLength": 1 },
        "execution_window": { "type": "string", "minLength": 1 },
        "rollback_plan": { "type": "string", "minLength": 1 },
        "observation_metrics": { "type": "string", "minLength": 1 },
        "stop_conditions": { "type": "string", "minLength": 1 },
        "post_release_owner": { "type": "string", "minLength": 1 }
      }
    },
    "role": { "enum": ["ANALYST", "ARCHITECT", "IMPLEMENTER", "TESTER", "INTEGRATOR", "REVIEWER"] },
    "read_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/projectPath" } },
    "write_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/projectPath" } },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "reviewer_task_id": { "type": "string", "pattern": "^(?:TASK-[0-9]{3,})?$", "deprecated": true, "description": "Legacy planning snapshot only; runtime state is authoritative." },
        "status": { "enum": ["unassigned", "pending", "running", "changes-required", "provisional-passed", "passed", "cancelled", "not-applicable"], "deprecated": true, "description": "Legacy planning snapshot only; runtime state is authoritative." }
      }
    },
    "risk_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["scope", "success_criteria", "overall_architecture", "public_interface", "data_model_or_migration", "security_privacy_compliance", "quality_gate_exception", "production_release", "irreversible_operation"] }
    },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": 2 } }, "required": ["schema_version"] },
      "then": { "required": ["role", "read_paths", "write_paths", "review"] }
    },
    {
      "if": { "properties": { "schema_version": { "const": 2 }, "profile": { "const": "Release" } }, "required": ["schema_version", "profile"] },
      "then": { "required": ["release_controls"] }
    }
  ],
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?![.*]?$).+$"
    }
  }
}
